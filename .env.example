# Local Supabase (supabase start). Values below are the CLI's fixed local defaults —
# they are not secrets and are safe to commit for a local-only stack.
# Where the *browser* reaches Supabase. Locally this is the Kong port; when serving
# the demo through a tunnel, set it to https://<domain>/supabase (see npm run proxy).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Where the *server* reaches it. Optional; defaults to the public URL above.
SUPABASE_INTERNAL_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACED_AFTER_START
SUPABASE_SERVICE_ROLE_KEY=REPLACED_AFTER_START

# inapp | twilio. Both write the notifications row; twilio additionally sends.
NOTIFY_PROVIDER=inapp

# Twilio WhatsApp sandbox — only read when NOTIFY_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# The local [auth.sms.test_otp] code, surfaced in the sign-in UI as a demo hint.
NEXT_PUBLIC_DEMO_OTP=123456

# Local demo only. Lets any phone number sign in without SMS, creating the account
# if it is new — which is what makes parent and trainer self-signup demoable when
# there is no SMS provider. Anyone who can reach the app can become any user, so
# this must never be set in a deployed environment.
ALLOW_DEV_SIGNIN=true
